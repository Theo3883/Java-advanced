<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Keycloak identity projection. VROS never stores credentials: only the stable
      Keycloak subject, the verified email and a display name are persisted.
    -->

    <!-- 1. Local users table (identity projection only) -->
    <changeSet id="13-create-users-table" author="vros">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="users"/></not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="keycloak_subject" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_keycloak_sub"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_email"/>
            </column>
            <column name="display_name" type="VARCHAR(150)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="users" indexName="idx_users_keycloak_sub">
            <column name="keycloak_subject"/>
        </createIndex>
    </changeSet>

    <!-- 2. Add user_id reference to customers (nullable: linked lazily on first verified login) -->
    <changeSet id="14-add-user-id-to-customers" author="vros">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="customers" columnName="user_id"/></not>
        </preConditions>
        <addColumn tableName="customers">
            <column name="user_id" type="BIGINT">
                <constraints foreignKeyName="fk_customers_user" references="users(id)"
                             unique="true" uniqueConstraintName="uk_customers_user_id"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 3. Add user_id reference to drivers (nullable: linked lazily on first verified login) -->
    <changeSet id="15-add-user-id-to-drivers" author="vros">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="drivers" columnName="user_id"/></not>
        </preConditions>
        <addColumn tableName="drivers">
            <column name="user_id" type="BIGINT">
                <constraints foreignKeyName="fk_drivers_user" references="users(id)"
                             unique="true" uniqueConstraintName="uk_drivers_user_id"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- 4. Direct driver-to-delivery assignment (bridges the pre-existing model gap) -->
    <changeSet id="16-add-driver-id-to-deliveries" author="vros">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="deliveries" columnName="assigned_driver_id"/></not>
        </preConditions>
        <addColumn tableName="deliveries">
            <column name="assigned_driver_id" type="BIGINT">
                <constraints foreignKeyName="fk_deliveries_driver" references="drivers(id)"/>
            </column>
        </addColumn>
        <createIndex tableName="deliveries" indexName="idx_deliveries_driver">
            <column name="assigned_driver_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
