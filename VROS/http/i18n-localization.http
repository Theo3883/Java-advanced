@baseUrl = http://localhost:8080/api/v1/customers

### 1.1 Validation Error - English (Default)
POST {{baseUrl}}
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "email": "not-valid",
  "lat": 150.0,
  "lng": -200.0
}

### 1.2 Validation Error - Romanian (Accept-Language: ro)
POST {{baseUrl}}
Content-Type: application/json
Accept-Language: ro
Accept: application/json

{
  "name": "",
  "email": "not-valid",
  "lat": 150.0,
  "lng": -200.0
}

### 2.1 404 Not Found - English (Default)
GET {{baseUrl}}/999999
Accept: application/json

### 2.2 404 Not Found - Romanian (Accept-Language: ro)
GET {{baseUrl}}/999999
Accept-Language: ro
Accept: application/json

### 3.1 409 Conflict - English (Default)
# Assumes an existing customer email (e.g. from InitialDataDemo)
POST {{baseUrl}}
Content-Type: application/json
Accept: application/json

{
  "name": "Duplicate User",
  "email": "customer1@example.com",
  "lat": 44.4,
  "lng": 26.1
}

### 3.2 409 Conflict - Romanian (Accept-Language: ro)
POST {{baseUrl}}
Content-Type: application/json
Accept-Language: ro
Accept: application/json

{
  "name": "Utilizator Duplicat",
  "email": "customer1@example.com",
  "lat": 44.4,
  "lng": 26.1
}
