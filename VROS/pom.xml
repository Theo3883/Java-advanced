<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.vros</groupId>
    <artifactId>vros-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>VROS Parent</name>
    <description>Vehicle Routing Optimization System - Multi-Module Clean Architecture</description>

    <modules>
        <module>vros-domain</module>
        <module>vros-application</module>
        <module>vros-infrastructure</module>
        <module>vros-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <jmh.version>1.37</jmh.version>
        <datafaker.version>2.4.0</datafaker.version>
        <archunit.version>1.3.0</archunit.version>

        <!-- Database connection properties (overridden by .env.local, CLI, or env vars) -->
        <db.uri>jdbc:postgresql://localhost:5432/vros</db.uri>
        <db.user>postgres</db.user>
        <db.pass>postgres</db.pass>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>org.vros</groupId>
                <artifactId>vros-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vros</groupId>
                <artifactId>vros-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vros</groupId>
                <artifactId>vros-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- External -->
            <dependency>
                <groupId>net.datafaker</groupId>
                <artifactId>datafaker</artifactId>
                <version>${datafaker.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- Preserve parameter names for Spring Security SpEL (#id, #req...) -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
