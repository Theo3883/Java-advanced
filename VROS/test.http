> {%
    client.test("Customer deleted with 204", function() {
        client.assert(response.status === 204, "Expected 204 No Content");
    });
%}

### 6.6 Verify Customer is gone (404)
GET {{api}}/customers/{{customerId}}

> {%
    client.test("Customer not found returns 404", function() {
