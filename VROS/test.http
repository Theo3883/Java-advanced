### ==============================================================================
### VROS API - Comprehensive End-to-End Test Suite (.http)
### Can be run directly from IntelliJ IDEA (Run button next to requests)
### ==============================================================================

@baseUrl = http://localhost:8080
@api = {{baseUrl}}/api/v1

### ------------------------------------------------------------------------------
### 0. OpenAPI & Documentation
### ------------------------------------------------------------------------------

### 0.1 Fetch OpenAPI JSON specification
GET {{baseUrl}}/api-docs
Accept: application/json

> {%
    client.test("OpenAPI spec is available", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.openapi.startsWith("3."), "Expected OpenAPI 3.x");
        client.assert(response.body.info.title !== undefined, "Title must be present");
    });
%}

### 0.2 Check Swagger UI HTML page
GET {{baseUrl}}/swagger-ui.html

> {%
    client.test("Swagger UI is reachable", function() {
        client.assert(response.status === 200 || response.status === 302, "Expected 200 or redirect");
    });
%}

### ------------------------------------------------------------------------------
### 1. Compulsory: Customer CRUD Operations
### ------------------------------------------------------------------------------

### 1.1 Create a new customer (JSON)
POST {{api}}/customers
Content-Type: application/json
Accept: application/json

{
  "name": "Alexandru Popescu",
  "email": "alex.popescu.{{$timestamp}}@example.com",
  "phone": "+40721112233",
  "address": "Strada Victoriei 45, Bucuresti",
  "lat": 44.4355,
  "lng": 26.1025
}

> {%
    client.test("Customer created with 201", function() {
        client.assert(response.status === 201, "Expected 201 Created");
        client.assert(response.body.id !== undefined, "Expected customer ID");
        client.assert(response.headers.valueOf("Location") !== null, "Expected Location header");
    });
    client.global.set("customerId", response.body.id);
    client.global.set("customerEmail", response.body.email);
%}

### 1.2 Get customer by ID (Includes HATEOAS discovery links)
GET {{api}}/customers/{{customerId}}
Accept: application/json

> {%
    client.test("Customer fetched successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.id == client.global.get("customerId"), "IDs should match");
        client.assert(response.body._links !== undefined, "HATEOAS links must be present");
        client.assert(response.body._links.self !== undefined, "self link must be present");
        client.assert(response.body._links.deliveries !== undefined, "deliveries link must be present");
    });
    // Save ETag for conditional request demo
    client.global.set("customerEtag", response.headers.valueOf("ETag"));
%}

### 1.3 List all customers
GET {{api}}/customers
Accept: application/json

> {%
    client.test("Customers listed successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.length > 0, "List should contain customers");
    });
%}

### 1.4 Search customers by name keyword
GET {{api}}/customers/search?keyword=Alexandru
Accept: application/json

> {%
    client.test("Search returned results", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.length >= 1, "Should find at least 1 customer");
    });
%}

### 1.5 Update customer
PUT {{api}}/customers/{{customerId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Alexandru Popescu Updated",
  "email": "{{customerEmail}}",
  "phone": "+40799887766",
  "address": "Bulevardul Unirii 100, Bucuresti",
  "lat": 44.4270,
  "lng": 26.1040
}

> {%
    client.test("Customer updated successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.name === "Alexandru Popescu Updated", "Name should be updated");
    });
%}

### ------------------------------------------------------------------------------
### 2. Advanced REST Features: HATEOAS, Content Negotiation, ETags, i18n
### ------------------------------------------------------------------------------

### 2.1 Content Negotiation: Receive Customer as XML
GET {{api}}/customers/{{customerId}}
Accept: application/xml

> {%
    client.test("Customer returned in XML format", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.contentType.mimeType === "application/xml", "Expected XML content type");
    });
%}

### 2.2 Content Negotiation: Create Customer using XML body
POST {{api}}/customers
Content-Type: application/xml
Accept: application/xml

<customer>
    <name>XML Customer</name>
    <email>xml.user.{{$timestamp}}@example.com</email>
    <phone>+40733445566</phone>
    <address>Strada Academiei 14</address>
    <lat>44.4360</lat>
    <lng>26.1010</lng>
</customer>

> {%
    client.test("Customer created via XML with 201", function() {
        client.assert(response.status === 201, "Expected 201 Created");
        client.assert(response.contentType.mimeType === "application/xml", "Expected XML response");
    });
%}

### 2.3 ETag Conditional Request: Expect 304 Not Modified
# Re-fetches with the ETag captured earlier. Since resource hasn't changed, returns 304.
GET {{api}}/customers/{{customerId}}
If-None-Match: {{customerEtag}}

> {%
    client.test("Conditional GET returns 304 Not Modified", function() {
        client.assert(response.status === 304, "Expected 304 Not Modified");
    });
%}

### 2.4 Bean Validation Error: English (Default)
POST {{api}}/customers
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "email": "invalid-email-address",
  "lat": 120.0,
  "lng": -250.0
}

> {%
    client.test("Validation failed with English messages", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request");
        client.assert(response.body.title === "Validation Failed", "Expected English title");
        client.assert(response.body.detail.includes("Name is required"), "Expected English message");
    });
%}

### 2.5 Bean Validation Error: Romanian (via Accept-Language: ro)
POST {{api}}/customers
Content-Type: application/json
Accept-Language: ro
Accept: application/json

{
  "name": "",
  "email": "invalid-email-address",
  "lat": 120.0,
  "lng": -250.0
}

> {%
    client.test("Validation failed with Romanian messages", function() {
        client.assert(response.status === 400, "Expected 400 Bad Request");
        client.assert(response.body.title === "Validare eșuată", "Expected Romanian title");
        client.assert(response.body.detail.includes("Numele este obligatoriu"), "Expected Romanian message");
    });
%}

### 2.6 Conflict Error (409): Duplicate Email (Romanian)
POST {{api}}/customers
Content-Type: application/json
Accept-Language: ro
Accept: application/json

{
  "name": "Duplicate Tester",
  "email": "{{customerEmail}}",
  "lat": 44.4,
  "lng": 26.1
}

> {%
    client.test("Duplicate email returns 409 Conflict in Romanian", function() {
        client.assert(response.status === 409, "Expected 409 Conflict");
        client.assert(response.body.title === "Conflict", "Expected title");
        client.assert(response.body.detail.includes("Emailul este deja utilizat"), "Expected Romanian conflict message");
    });
%}

### 2.7 Not Found Error (404): Non-existent ID in Romanian
GET {{api}}/customers/999999
Accept-Language: ro

> {%
    client.test("Not found returns 404 in Romanian", function() {
        client.assert(response.status === 404, "Expected 404 Not Found");
        client.assert(response.body.title === "Resursă negăsită", "Expected Romanian title");
        client.assert(response.body.detail.includes("nu a fost găsit"), "Expected Romanian detail message");
    });
%}

### ------------------------------------------------------------------------------
### 3. Vehicles CRUD (Single Depot Assumption)
### ------------------------------------------------------------------------------

### 3.1 Create vehicle (Depot ID omitted - uses single depot fallback)
POST {{api}}/vehicles
Content-Type: application/json
Accept: application/json

{
  "name": "Mercedes Sprinter Fleet-01",
  "capacity": 1500,
  "available": true
}

> {%
    client.test("Vehicle created with 201", function() {
        client.assert(response.status === 201, "Expected 201 Created");
        client.assert(response.body.id !== undefined, "Expected vehicle ID");
        client.assert(response.body.capacity === 1500, "Capacity should match");
    });
    client.global.set("vehicleId", response.body.id);
%}

### 3.2 List all vehicles
GET {{api}}/vehicles
Accept: application/json

> {%
    client.test("Vehicles listed successfully", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.length > 0, "Expected at least 1 vehicle");
    });
%}

### 3.3 List available vehicles only
GET {{api}}/vehicles/available
Accept: application/json

> {%
    client.test("Available vehicles listed", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 3.4 Get vehicle by ID
GET {{api}}/vehicles/{{vehicleId}}
Accept: application/json

> {%
    client.test("Vehicle retrieved by ID", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.name === "Mercedes Sprinter Fleet-01");
    });
%}

### 3.5 Update vehicle availability and capacity
PUT {{api}}/vehicles/{{vehicleId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Mercedes Sprinter Fleet-01-Optimized",
  "capacity": 1800,
  "available": false
}

> {%
    client.test("Vehicle updated", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.capacity === 1800, "Capacity should be 1800");
        client.assert(response.body.available === false, "Available should be false");
    });
%}

### ------------------------------------------------------------------------------
### 4. Deliveries CRUD Operations
### ------------------------------------------------------------------------------

### 4.1 Create delivery for customer
POST {{api}}/deliveries
Content-Type: application/json
Accept: application/json

{
  "customerId": {{customerId}},
  "quantity": 30,
  "notes": "Fragile packages - Handle with care before 14:00"
}

> {%
    client.test("Delivery created with 201", function() {
        client.assert(response.status === 201, "Expected 201 Created");
        client.assert(response.body.id !== undefined, "Expected delivery ID");
        client.assert(response.body.quantity === 30, "Quantity should be 30");
    });
    client.global.set("deliveryId", response.body.id);
%}

### 4.2 List deliveries
GET {{api}}/deliveries
Accept: application/json

> {%
    client.test("Deliveries listed", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 4.3 Get delivery by ID
GET {{api}}/deliveries/{{deliveryId}}
Accept: application/json

> {%
    client.test("Delivery retrieved", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.quantity === 30, "Quantity should match");
    });
%}

### 4.4 Discover customer deliveries via HATEOAS relation
GET {{api}}/deliveries/customer/{{customerId}}
Accept: application/json

> {%
    client.test("Customer deliveries discovered", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.length >= 1, "Should have at least 1 delivery");
    });
%}

### 4.5 Update delivery notes and quantity
PUT {{api}}/deliveries/{{deliveryId}}
Content-Type: application/json
Accept: application/json

{
  "customerId": {{customerId}},
  "quantity": 35,
  "notes": "Updated: Deliver directly to 2nd floor warehouse"
}

> {%
    client.test("Delivery updated", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.quantity === 35, "Quantity should be 35");
    });
%}

### ------------------------------------------------------------------------------
### 5. Scenarios CRUD (Many-to-Many Optimization Problem Definitions)
### ------------------------------------------------------------------------------

### 5.1 Create Scenario linking Vehicles and Deliveries (ManyToMany)
POST {{api}}/scenarios
Content-Type: application/json
Accept: application/json

{
  "name": "Bucharest Morning Rush Optimization",
  "vehicleIds": [{{vehicleId}}],
  "deliveryIds": [{{deliveryId}}]
}

> {%
    client.test("Scenario created with 201", function() {
        client.assert(response.status === 201, "Expected 201 Created");
        client.assert(response.body.id !== undefined, "Expected scenario ID");
        client.assert(response.body.name === "Bucharest Morning Rush Optimization");
        client.assert(response.body.vehicleIds.length === 1, "Expected 1 vehicle link");
        client.assert(response.body.deliveryIds.length === 1, "Expected 1 delivery link");
    });
    client.global.set("scenarioId", response.body.id);
%}

### 5.2 Get Scenario by ID with associations
GET {{api}}/scenarios/{{scenarioId}}
Accept: application/json

> {%
    client.test("Scenario retrieved with associations", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.vehicleIds.includes(parseInt(client.global.get("vehicleId"))));
        client.assert(response.body.deliveryIds.includes(parseInt(client.global.get("deliveryId"))));
    });
%}

### 5.3 List all scenarios
GET {{api}}/scenarios
Accept: application/json

> {%
    client.test("Scenarios listed", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.length > 0, "Expected scenarios in list");
    });
%}

### 5.4 Search scenario by keyword
GET {{api}}/scenarios/search?keyword=Morning
Accept: application/json

> {%
    client.test("Scenario search returned results", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.length >= 1, "Found matching scenario");
    });
%}

### 5.5 Update Scenario associations
PUT {{api}}/scenarios/{{scenarioId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Bucharest Morning Rush Optimization - Phase 2",
  "vehicleIds": [{{vehicleId}}],
  "deliveryIds": []
}

> {%
    client.test("Scenario updated", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.name.includes("Phase 2"), "Name should be updated");
        client.assert(response.body.deliveryIds.length === 0, "Delivery list cleared");
    });
%}

