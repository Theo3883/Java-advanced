### 6. Cleanup / Deletion Verification
### ------------------------------------------------------------------------------

### 6.1 Delete Scenario
DELETE {{api}}/scenarios/{{scenarioId}}

> {%
    client.test("Scenario deleted with 204", function() {
        client.assert(response.status === 204, "Expected 204 No Content");
    });
%}

### 6.2 Verify Scenario is gone (404)
GET {{api}}/scenarios/{{scenarioId}}

> {%
    client.test("Scenario not found returns 404", function() {
        client.assert(response.status === 404, "Expected 404 Not Found");
    });
%}

