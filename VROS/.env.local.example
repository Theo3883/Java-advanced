# Database Connection
db.uri=jdbc:postgresql://localhost:5432/vros
db.user=postgres
db.pass=postgres

# Alternative / Liquibase-native aliases
url=jdbc:postgresql://localhost:5432/vros
username=postgres
password=postgres
DB_URI=jdbc:postgresql://localhost:5432/vros
DB_USER=postgres
DB_PASS=postgres

# Keycloak / OIDC (optional overrides)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/vros
# KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/vros/protocol/openid-connect/certs

# Swagger/OpenAPI exposure in the prod profile (default: false)
ENABLE_SWAGGER=false

# Kafka (local Docker Compose broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VROS_KAFKA_REQUESTS=vros.optimization.requests
VROS_KAFKA_ACKS=vros.optimization.acks
VROS_KAFKA_RESULTS=vros.optimization.results
VROS_KAFKA_PROGRESS=vros.optimization.progress
VROS_KAFKA_REQUESTS_DLT=vros.optimization.requests-dlt
VROS_KAFKA_RESULTS_DLT=vros.optimization.results-dlt
