# Database Connection
db.uri=jdbc:postgresql://localhost:5432/vros
db.user=postgres
db.pass=postgres

# Alternative / Liquibase-native aliases
url=jdbc:postgresql://localhost:5432/vros
username=postgres
password=postgres
DB_URI=jdbc:postgresql://localhost:5432/vros
DB_USER=postgres
DB_PASS=postgres

# Keycloak / OIDC (optional overrides)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/vros
# KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/vros/protocol/openid-connect/certs

# Swagger/OpenAPI exposure in the prod profile (default: false)
ENABLE_SWAGGER=false
